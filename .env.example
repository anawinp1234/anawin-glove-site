# Use "local" until the Shopify store, products, and Headless channel are ready.
VITE_COMMERCE_MODE=local

# Public storefront configuration. Never put Admin API or private tokens here.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=replace-with-public-storefront-token
VITE_SHOPIFY_API_VERSION=2026-07
VITE_JUDGEME_PUBLIC_TOKEN=

# Exact Shopify product handles. Each product must have one purchasable variant.
VITE_SHOPIFY_BR16_HANDLE=
VITE_SHOPIFY_OB16_HANDLE=
VITE_SHOPIFY_CL16_HANDLE=
VITE_SHOPIFY_BREAK_IN_HANDLE=

# Optional full-size commerce mapping. Pages remain Coming Soon regardless of these handles.
# Used by the isolated purchase rehearsal and reviewed launch integration.
VITE_SHOPIFY_MI26_HANDLE=
VITE_SHOPIFY_BL50_HANDLE=
VITE_SHOPIFY_OR17_HANDLE=
VITE_SHOPIFY_CM24_HANDLE=
