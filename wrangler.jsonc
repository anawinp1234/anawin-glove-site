{
  "name": "anawin-glove-site",
  "compatibility_date": "2026-09-14",
  "main": "./worker/index.js",
  "keep_vars": true,
  "vars": {
    "SHOPIFY_STORE_DOMAIN": "ignvv0-zh.myshopify.com",
    "SHOPIFY_ADMIN_API_VERSION": "2026-07",
    "NEWSLETTER_OPT_IN_MODE": "single"
  },
  "secrets": {
    "required": ["SHOPIFY_CLIENT_ID", "SHOPIFY_CLIENT_SECRET"]
  },
  "ratelimits": [
    { "name": "NEWSLETTER_IP_LIMITER", "namespace_id": "732611", "simple": { "limit": 30, "period": 60 } },
    { "name": "NEWSLETTER_EMAIL_LIMITER", "namespace_id": "732612", "simple": { "limit": 3, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
