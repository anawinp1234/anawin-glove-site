{
  "name": "anawin-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-build-config.mjs && node scripts/check-source-imports.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && node --test",
    "test:browser:cart": "node scripts/browser/cart-break-in-browser.mjs",
    "test:browser:recovery": "node scripts/browser/cart-recovery-browser.mjs",
    "test:browser:purchase": "node scripts/browser/run-isolated.mjs scripts/browser/purchase-regression-browser.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.5",
    "wrangler": "^4.133.0"
  }
}
